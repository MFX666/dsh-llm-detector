{
  "name": "@local/dsh-llm-detector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: detect whether a configured model is an LMFPD-listed model via 3 counting challenges.",
  "main": "./index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-typert-registry",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.js",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "typert.js",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "test/"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "lmfpd-sdk": "0.2.0"
  },
  "engines": { "node": ">=22" }
}
